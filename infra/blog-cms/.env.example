# Copiare in `.env` SULLA VPS (non in questo repository) e riempire.
# Sulla macchina il file va a permessi 600: contiene le chiavi di entrambi i blog.
#
# I token devono essere IDENTICI a quelli impostati su Vercel, ciascuno per il suo sito:
# sono la stessa serratura vista dai due lati.
#
# ⚠️ TRAPPOLA: `docker compose` espande `$nome` dentro questo file. Una password che
# contiene `$` seguito da lettere arriva TRONCATA al contenitore, senza nessun errore e
# senza nessun avviso. Raddoppiare ogni `$` (`$$`), o generare password che non ne hanno.

# --- database (uno solo, con uno schema e un utente per sito) ---
DB_ROOT_PASSWORD=              # lunga e casuale, non serve ricordarla
DB_PASSWORD=                   # utente wpuser (Evalis Academy)
DB_PASSWORD_EVALISDECK=        # utente wpuser_evalisdeck

# --- sito 1: Evalis Academy ---
SITO_PUBBLICO=https://evalisacademy.it
BLOG_WEBHOOK_TOKEN=            # = BLOG_WEBHOOK_TOKEN su Vercel. Non finisce mai in un URL.
BLOG_PREVIEW_TOKEN=            # = BLOG_PREVIEW_TOKEN su Vercel. Viaggia negli URL di anteprima.

# --- sito 2: EvalisDeck ---
SITO_PUBBLICO_EVALISDECK=https://evalisdeck.it
BLOG_WEBHOOK_TOKEN_EVALISDECK= # generare con: openssl rand -hex 32
BLOG_PREVIEW_TOKEN_EVALISDECK= # idem, e diverso dal precedente

# --- backup cifrati sullo Storage Box ---
BACKUP_PASSPHRASE=             # senza questa i backup non si riaprono: va nel gestore password
STORAGE_BOX_HOST=
STORAGE_BOX_USER=

# --- allarme se il backup notturno fallisce (facoltativo ma consigliato) ---
RESEND_API_KEY=                # la stessa usata dal sito
ALLARME_FROM=EvalisDeck <no-reply@evalisdeck.it>
ALLARME_A=                     # a chi scrivere quando il backup non riesce
